# Copy to .env (gitignored) and fill in. Never commit .env.
# Loaded only by scripts/with-env (uv run --env-file .env); CodePilot+ code itself never reads this file.
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
# GitHub App that CodePilot+ acts as (app id, and the path to its private key file)
CODEPILOT_GH_APP_ID=
CODEPILOT_GH_APP_KEY_PATH=
# LangSmith tracing of every model call
LANGSMITH_API_KEY=
# Optional: only for scripts/evaluate.py's judge probes (the reviewer Action has its own key as a GitHub secret)
OPENAI_API_KEY=
